  "sections": [
    {
      "id": "ai-提供商",
      "title": "AI 提供商",
      "depth": 0,
      "anchor": "ai-提供商",
      "summary": "本页介绍如何为 Hermes Agent 配置推理提供商——从 OpenRouter、Anthropic 等云端 API，到 Ollama、vLLM 等自托管端点，再到高级路由与故障转移配置。使用 Hermes 至少需要配置一个提供商。",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#ai-提供商"
    },
    {
      "id": "推理提供商",
      "title": "推理提供商",
      "depth": 1,
      "anchor": "推理提供商",
      "summary": "你需要至少一种方式连接到 LLM。使用 hermes model 交互式切换提供商和模型，或直接配置：",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#推理提供商"
    },
    {
      "id": "nous-portal",
      "title": "Nous Portal",
      "depth": 2,
      "anchor": "nous-portal",
      "summary": "Nous Portal 是 Nous Research 的统一订阅网关，也是运行 Hermes Agent 的推荐方式。一次 OAuth 登录即可访问 300+ 前沿智能体模型（Claude、GPT、Gemini、DeepSeek、Qwen、Kimi、GLM、MiniMax、Grok 等）以及 Tool Gateway（网页搜索、图像生成、TTS、浏览器自动化）——费用从你的 Nous 订阅中扣…",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#nous-portal"
    },
    {
      "id": "模型管理的两个命令",
      "title": "模型管理的两个命令",
      "depth": 2,
      "anchor": "模型管理的两个命令",
      "summary": "Hermes 有两个模型命令，用途不同：",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#模型管理的两个命令"
    },
    {
      "id": "anthropic原生",
      "title": "Anthropic（原生）",
      "depth": 2,
      "anchor": "anthropic原生",
      "summary": "通过 Anthropic API 直接使用 Claude 模型——无需 OpenRouter 代理。支持三种认证方式：",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#anthropic原生"
    },
    {
      "id": "github-copilot",
      "title": "GitHub Copilot",
      "depth": 2,
      "anchor": "github-copilot",
      "summary": "Hermes 以一等提供商身份支持 GitHub Copilot，提供两种模式：",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#github-copilot"
    },
    {
      "id": "一等-api-key-提供商",
      "title": "一等 API Key 提供商",
      "depth": 2,
      "anchor": "一等-api-key-提供商",
      "summary": "这些提供商内置支持，具有专属提供商 ID。设置 API key 后使用 --provider 选择：",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#一等-api-key-提供商"
    },
    {
      "id": "xaigrok-responses-api-prompt-缓存",
      "title": "xAI（Grok）— Responses API + Prompt 缓存",
      "depth": 2,
      "anchor": "xaigrok-responses-api-prompt-缓存",
      "summary": "xAI 通过 Responses API（codex_responses 传输）接入，自动支持 Grok 4 模型的推理——无需 reasoning_effort 参数，服务端默认进行推理。在 ~/.hermes/.env 中设置 XAI_API_KEY 并在 hermes model 中选择 xAI，或直接用 grok 作为快捷方式输入 /model grok-4-1-fast-reasoni…",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#xaigrok-responses-api-prompt-缓存"
    },
    {
      "id": "novitaai",
      "title": "NovitaAI",
      "depth": 2,
      "anchor": "novitaai",
      "summary": "NovitaAI 是面向开发者和智能体的 AI 原生云平台。三条产品线：200+ 模型的 Model API、用于构建和运行 AI 智能体的 Agent Sandbox，以及可扩展计算的 GPU Cloud，均可从同一平台访问。",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#novitaai"
    },
    {
      "id": "ollama-cloud-托管-ollama-模型oauth-api-key",
      "title": "Ollama Cloud — 托管 Ollama 模型，OAuth + API Key",
      "depth": 2,
      "anchor": "ollama-cloud-托管-ollama-模型oauth-api-key",
      "summary": "Ollama Cloud 托管与本地 Ollama 相同的开源模型目录，无需 GPU。在 hermes model 中选择 Ollama Cloud，粘贴来自 ollama.com/settings/keys 的 API key，Hermes 会自动发现可用模型。",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#ollama-cloud-托管-ollama-模型oauth-api-key"
    },
    {
      "id": "aws-bedrock",
      "title": "AWS Bedrock",
      "depth": 2,
      "anchor": "aws-bedrock",
      "summary": "通过 AWS Bedrock 使用 Anthropic Claude、Amazon Nova、DeepSeek v3.2、Meta Llama 4 等模型。使用 AWS SDK（boto3）凭据链——无需 API key，使用标准 AWS 认证即可。",
      "url": "https://hermes-agent.nousresearch.com/docs/zh-Hans/integrations/providers#aws-bedrock"
    },
    {
      "id": "qwen-portaloauth",
      "title": "Qwen Portal（OAuth）",
